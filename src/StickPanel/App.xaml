<Application
    x:Class="StickPanel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#A8FFFFFF" />
                    <SolidColorBrush x:Key="TaskHoverBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#A81D1D1D" />
                    <SolidColorBrush x:Key="TaskHoverBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
