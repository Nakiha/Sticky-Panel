<Window
    x:Class="StickPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StickPanel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Stick Panel">

    <Border
        x:Name="PanelBorder"
        Background="{ThemeResource PanelSurfaceBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid x:Name="MainRoot" KeyDown="MainRoot_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid" Grid.Row="0" Padding="10,0,146,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleButton
                    x:Name="TopmostButton"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="TopmostButton_Changed"
                    CornerRadius="8"
                    IsChecked="True"
                    ToolTipService.ToolTip="Always on top  ·  Ctrl+Shift+A"
                    Unchecked="TopmostButton_Changed">
                    <FontIcon FontSize="14" Glyph="&#xE718;" />
                </ToggleButton>

                <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="130"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text="STICK PANEL" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="18,8,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="PanelTitleBox"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="25"
                    FontWeight="SemiBold"
                    PlaceholderText="Panel title"
                    TextChanged="AnyTextChanged" />

                <Button
                    x:Name="ClearCompletedButton"
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Click="ClearCompleted_Click"
                    CornerRadius="9"
                    ToolTipService.ToolTip="Clear completed tasks">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0,10,0">
                <ListView
                    x:Name="TaskList"
                    Background="Transparent"
                    IsItemClickEnabled="False"
                    SelectionMode="None"
                    ShowsScrollingPlaceholders="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="44" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,3" ColumnSpacing="5" Opacity="{Binding ContentOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    VerticalAlignment="Center"
                                    Click="TaskCheckBox_Click"
                                    IsChecked="{Binding IsDone, Mode=TwoWay}" />

                                <TextBox
                                    Grid.Column="1"
                                    MinHeight="36"
                                    Padding="7,5"
                                    VerticalContentAlignment="Center"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    KeyDown="TaskTextBox_KeyDown"
                                    LostFocus="TaskTextBox_LostFocus"
                                    Text="{Binding Text, Mode=TwoWay}"
                                    TextWrapping="Wrap" />

                                <Button
                                    Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Click="DeleteTask_Click"
                                    CornerRadius="8"
                                    Opacity="0.66"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="Delete">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Spacing="6">
                    <FontIcon FontSize="26" Glyph="&#xE73E;" />
                    <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Text="Nothing left. Nice." />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="16,10,16,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="NewTaskBox"
                    MinHeight="40"
                    Padding="12,8"
                    KeyDown="NewTaskBox_KeyDown"
                    PlaceholderText="Add a task…"
                    TextWrapping="Wrap" />

                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    Click="AddTask_Click"
                    CornerRadius="10"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Add task">
                    <FontIcon FontSize="15" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <Grid Grid.Row="4" Margin="20,0,20,12">
                <TextBlock
                    x:Name="TaskCountText"
                    FontSize="11"
                    Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="Ctrl+Enter to add" />
            </Grid>

            <InfoBar
                x:Name="SaveErrorBar"
                Grid.Row="0"
                Grid.RowSpan="5"
                Margin="12"
                VerticalAlignment="Bottom"
                IsClosable="True"
                IsOpen="False"
                IsTabStop="False"
                Severity="Error"
                Title="Could not save beside the app" />
        </Grid>
    </Border>
</Window>
